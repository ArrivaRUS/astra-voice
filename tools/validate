CANCEL_LIMIT_MS = 1000.0
SILENT_LIMIT_MS = 2200.0


def positive_int(raw: str) -> int:
    """Принимает только положительное число потоков."""
    value = int(raw)
    if value < 1:
        raise argparse.ArgumentTypeError("Нужно целое число от 1.")
    return value


def delay_ms(raw: str) -> float:
    """Отклоняет отрицательную и бесконечную задержку."""
    value = float(raw)
    if not math.isfinite(value) or value < 0:
        raise argparse.ArgumentTypeError("Нужно конечное число от 0.")
    return value


def stats(args: argparse.Namespace) -> int:
    """Оценивает Ц2 по прогретым диктовкам, при необходимости только после --since."""
    explanation = ""
    try:
        events = Stats().events()
        if args.since is not None:
            events = [event for event in events if float(event["ts"]) > args.since]
    except (OSError, RuntimeError) as exc:
        events = []
        explanation = f"Не удалось прочитать статистику: {exc}"
    dictations = [event for event in events if event["type"] == "dictation"]
    timings = [
        float(event["t_ms"])
        for event in dictations
        if event.get("cold") is False and "t_ms" in event
    ]
    p95 = percentile(timings, 95)
    code = 2 if p95 is None else int(p95 > args.target_ms)
    verdict = {0: "уложились", 1: "не уложились", 2: "нет данных"}[code]
    facts = {
        "events": len(events),
        "dictations": len(dictations),
        "p50_ms": percentile(timings, 50),
        "p95_ms": p95,
        "results": {
            result: sum(event.get("result") == result for event in dictations)
            for result in ("ok", "empty", "cancelled")
        },
        "mic_errors": sum(event["type"] == "mic_error" for event in events),
        "target_ms": args.target_ms,
        "verdict": verdict,
    }
    if args.json:
        print(json.dumps(facts, ensure_ascii=False), flush=True)
        if explanation:
            print(explanation, file=sys.stderr)
    else:
        print(f"Диктовок: {len(dictations)}; ошибок микрофона: {facts['mic_errors']}.")
        measured = "нет данных" if p95 is None else f"{p95:g} мс"
        print(f"p95: {measured}; цель ≤ {args.target_ms:g} мс; вердикт: {verdict}.")
        if explanation:
            print(explanation)
    return code


def model_request(args: argparse.Namespace) -> Message:
    """Читает настройки без записи; приоритет аргументов совпадает с отладочным CLI."""
    config_root = os.environ.get("XDG_CONFIG_HOME", "")
    config = Path(config_root) if config_root.startswith("/") else Path.home() / ".config"
    path = config / "astra-voice" / "settings.json"
    raw = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
    if not isinstance(raw, dict):
        raise ValueError("Настройки должны быть JSON-объектом.")
    effective = policy.effective(settings.from_dict(raw), policy.load()).to_dict()

    def option(name: str, default: Any = None) -> Any:
        """Выбирает аргумент, настройку с префиксом, старую настройку или дефолт."""
        for value in (
            getattr(args, name, None),
            effective.get(f"model_{name}"),
            effective.get(name),
        ):
            if value is not None:
                return value
        return default

    directory = option("dir")
    model_id, revision = option("id"), option("revision")
    if args.model_dir is not None:
        directory = args.model_dir.expanduser().resolve()
        model_id, revision = directory.parent.name or "local-model", directory.name or "local"
    elif not model_id or not revision:
        raise ValueError("Модель не настроена. Укажите --model-dir.")
    if directory is None:
        data_root = os.environ.get("XDG_DATA_HOME", "")
        data = Path(data_root) if data_root.startswith("/") else Path.home() / ".local/share"
        directory = data / "astra-voice/store" / model_id / revision
    directory = Path(directory).expanduser().resolve()
    if not directory.is_dir():
        raise ValueError("Каталог модели не найден. Проверьте --model-dir.")
    request: Message = {
        "type": "model.load",
        "id": model_id,
        "revision": revision,
        "dir": str(directory),
        "layout": option("layout", "onnx-asr-gigaam-v3"),
        "variant": option("variant", "gigaam-v3-e2e-rnnt"),
        "threads": option("threads", 2),
        "min_ram_mb": option("min_ram_mb", 768),
    }
    ipc.encode(request)
    if request["threads"] < 1 or request["min_ram_mb"] < 1:
        raise ValueError("Число потоков и объём памяти должны быть положительными.")
    return request


def worker_cancel(args: argparse.Namespace) -> int:
    """Запускает файл и измеряет получение подтверждения отмены без GUI и микрофона."""
    events: deque[tuple[float, Message]] = deque()

    def receive(event: Message) -> None:
        """Фиксирует время именно в callback, до форматирования вывода."""
        events.append((time.monotonic(), event))

    supervisor = WorkerSupervisor(on_event=receive, use_qt=False)
    facts: Message = {
        "command": "worker-cancel",
        "mode": "transcribe.file",
        "threshold_ms": CANCEL_LIMIT_MS,
        "cancel_after_ms": args.cancel_after_ms,
        "cancel_ms": None,
    }

    def finish(code: int, explanation: str) -> int:
        """Пишет только stdout; распознанный текст в журнал не попадает."""
        verdict = {0: "уложились", 1: "не уложились", 2: "прогнать не удалось"}[code]
        facts.update(exit_code=code, verdict=verdict, explanation=explanation)
        if args.json:
            print(json.dumps(facts, ensure_ascii=False), flush=True)
        else:
            print("Способ: transcribe.file (WAV из файла, без микрофона).")
            elapsed = facts["cancel_ms"]
            measured = "не измерено" if elapsed is None else f"{elapsed:.3f} мс"
            print(f"Отмена: {measured}; порог ≤ {CANCEL_LIMIT_MS:g} мс; {verdict}.")
            print(explanation)
        return code

    def wait(kind: str, seconds: float) -> Message:
        """Ожидает событие с ограничением времени и обработкой ошибок запуска."""
        deadline = time.monotonic() + seconds
        while True:
            while events:
                _, event = events.popleft()
                if event["type"] == "error":
                    raise RuntimeError(f"Воркер сообщил ошибку: {event['code']}.")
                if event["type"] == kind:
                    return event
            remaining = deadline - time.monotonic()
            if remaining <= 0 or supervisor.state == "stopped":
                raise RuntimeError(f"Не дождались события {kind}.")
            supervisor.pump(min(remaining, 0.005))

    try:
        request = model_request(args)
        wav: Path = args.wav.expanduser().resolve()
        if not wav.is_file():
            return finish(2, "Звуковой файл не найден. Проверьте --wav.")
        facts.update(wav=str(wav), variant=request["variant"], threads=request["threads"])
        supervisor.start()
        hello = wait("hello", 10)
        if hello["runtime"]["onnxruntime"] is None:
            return finish(2, "Движок onnxruntime недоступен в выбранном Python.")
        supervisor.send(request, timeout=10)
        loaded = wait("model.loaded", 12)
        facts["engine_version"] = loaded["engine_version"]
        started = time.monotonic()
        supervisor.send({"type": "transcribe.file", "path": str(wav)}, timeout=120)
        cancel_at = started + args.cancel_after_ms / 1000
        while time.monotonic() < cancel_at:
            supervisor.pump(min(0.005, max(0, cancel_at - time.monotonic())))
            if events:
                break
        # Забираем уже доступный result перед отменой, чтобы не получить ложный PASS.
        supervisor.pump()
        if events:
            _, event = events.popleft()
            facts["event"] = event["type"]
            if event["type"] == "result":
                return finish(2, "Распознавание уже завершилось. Уменьшите --cancel-after-ms.")
            return finish(2, f"До отмены пришло событие {event['type']}: {event.get('code', '')}.")
        generation = supervisor.generation
        sent_at = time.monotonic()
        sent = supervisor.send({"type": "record.cancel", "utterance_id": "file"})
        facts["actual_cancel_after_ms"] = (sent_at - started) * 1000
        if sent is None:
            return finish(2, "Распознавание уже завершилось. Уменьшите --cancel-after-ms.")
        deadline = sent_at + 3
        while True:
            while events:
                received_at, event = events.popleft()
                if event["type"] == "cancelled" and event.get("utterance_id") == "file":
                    if event["generation"] != generation:
                        continue
                    elapsed = (received_at - sent_at) * 1000
                    facts["cancel_ms"] = elapsed
                    return finish(
                        int(elapsed > CANCEL_LIMIT_MS),
                        "Измерено время от send(record.cancel) до callback(cancelled).",
                    )
                if event["type"] in ("error", "result"):
                    facts["event"] = event["type"]
                    facts["error_code"] = event.get("code")
                    return finish(1, "После отмены пришло другое завершающее событие.")
            remaining = deadline - time.monotonic()
            if remaining <= 0 or supervisor.state == "stopped":
                facts["waited_ms"] = (time.monotonic() - sent_at) * 1000
                return finish(1, "Подтверждение cancelled не получено; ожидание ограничено 3 с.")
            supervisor.pump(min(remaining, 0.005))
    except (OSError, TypeError, ValueError, RuntimeError, ipc.FrameError) as exc:
        return finish(2, f"Не удалось выполнить проверку: {exc}")
    finally:
        supervisor.stop()


class DictationFailure(Exception):
    """Прерывает сценарий с вердиктом, сохраняя обязательную уборку."""

    def __init__(self, code: int, explanation: str) -> None:
        super().__init__(explanation)
        self.code = code


def dictation(args: argparse.Namespace) -> int:
    """Проверяет захват, тишину, лимит и распознавание через публичный IPC."""
    device = args.device if args.device is not None else "av_test_src"
    facts: Message = {
        "command": "dictation",
        "mode": "toggle" if args.toggle else "ptt",
        "audio_mode": "wav" if args.wav is not None else "silence",
        "device": device,
        "virtual_mic": args.virtual_mic,
        "utterance_id": "d1",
        "limit_expected": args.limit,
        "record_limit": False,
        "level_count": 0,
        "max_peak_dbfs": None,
        "silent_ms": None,
        "threshold_ms": SILENT_LIMIT_MS,
    }
    events: dict[str, tuple[float, Message]] = {}
    errors: deque[Message] = deque()
    player: subprocess.Popen[bytes] | None = None
    virtual_started = False
    steps: list[str] = []

    def receive(event: Message) -> None:
        """Сохраняет первые события и агрегирует уровни без журналирования текста."""
        received_at = time.monotonic()
        if event["generation"] != generation:
            return
        kind = event["type"]
        if event.get("utterance_id") not in (None, "d1"):
            return
        if kind == "error":
            errors.append(event)
        elif kind == "level":
            facts["level_count"] += 1
            peak = event["peak_dbfs"]
            previous = facts["max_peak_dbfs"]
            facts["max_peak_dbfs"] = peak if previous is None else max(previous, peak)
        else:
            events.setdefault(kind, (received_at, event))
            if kind == "record.limit" and event.get("utterance_id") == "d1":
                facts["record_limit"] = True
            if kind == "silent" and "audio.ready" in events:
                facts["silent_ms"] = (events["silent"][0] - events["audio.ready"][0]) * 1000

    supervisor = WorkerSupervisor(on_event=receive, use_qt=False)
    generation = supervisor.generation

    def on_state(state: HotkeyState, reason: str) -> None:
        """Только переходы настоящего автомата управляют IPC в режиме toggle."""
        if state == HotkeyState.RECORDING:
            supervisor.send({"type": "record.start", "utterance_id": "d1", "device": device})
        elif state == HotkeyState.PROCESSING:
            # При record.limit воркер уже остановил запись.
            if not facts["record_limit"]:
                supervisor.send({"type": "record.stop", "utterance_id": "d1"})
            supervisor.send({"type": "recognize", "utterance_id": "d1"}, timeout=120)

    fsm = HotkeyFsm(HotkeyMode.TOGGLE, on_state=on_state)

    def second_tap() -> None:
        now = time.monotonic()
        fsm.press(now)
        if fsm.state != HotkeyState.PROCESSING:
            raise DictationFailure(1, "Второе нажатие не завершило запись в режиме toggle.")
        fsm.release(now + PTT_THRESHOLD_S / 2)

    def check_worker() -> None:
        """Ошибки устройства нарушают критерий; сбой воркера мешает прогону."""
        if errors:
            event = errors.popleft()
            facts.update(error_code=event["code"], error_message=event["message"])
            code = 1 if event["code"] in ("audio-no-device", "audio-busy", "audio-failed") else 2
            raise DictationFailure(code, f"Воркер: {event['code']}: {event['message']}")
        if supervisor.state == "stopped" or supervisor.generation != generation:
            raise DictationFailure(2, "Воркер остановился или сменил поколение во время прогона.")

    def pump(seconds: float) -> None:
        supervisor.pump(min(max(0, seconds), 0.005))
        check_worker()

    def wait(kind: str, seconds: float, code: int = 2) -> tuple[float, Message]:
        """Ожидает событие, не теряя silent и record.limit между этапами."""
        deadline = time.monotonic() + seconds
        while True:
            check_worker()
            if kind in events:
                return events[kind]
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise DictationFailure(code, f"Не дождались события {kind} за {seconds:g} с.")
            pump(remaining)

    def record_for(seconds: float) -> None:
        deadline = time.monotonic() + seconds
        while time.monotonic() < deadline:
            pump(deadline - time.monotonic())
        pump(0)

    def virtual_mic(action: str) -> None:
        """Перехватывает stdout скрипта, чтобы JSON оставался одним объектом."""
        result = subprocess.run(
            [str(ROOT / "scripts/e2e/virtual_mic.sh"), action],
            capture_output=True,
            text=True,
            timeout=30,
            check=False,
        )
        facts[f"virtual_mic_{action}"] = result.returncode
        if result.returncode:
            detail = (result.stderr or result.stdout).strip()
            raise DictationFailure(2, f"virtual_mic.sh {action}: код {result.returncode}. {detail}")

    def run() -> tuple[int, str]:
        nonlocal player, virtual_started
        if not args.virtual_mic and args.device is None:
            raise DictationFailure(2, "Без --virtual-mic требуется явный --device.")
        if not device.strip():
            raise DictationFailure(2, "Укажите непустое имя источника в --device.")
        wav: Path | None = None
        duration = 0.0
        if args.wav is not None:
            wav = args.wav.expanduser().resolve()
            if not wav.is_file():
                raise DictationFailure(2, "Звуковой файл не найден. Проверьте --wav.")
            with wave.open(str(wav), "rb") as source:
                duration = source.getnframes() / source.getframerate()
            facts.update(wav=str(wav), wav_seconds=duration, sink="av_test")
        if args.virtual_mic:
            virtual_mic("up")
            virtual_started = True
            steps.append("Виртуальный микрофон поднят.")
        supervisor.start()
        _, hello = wait("hello", 10)
        if hello["runtime"]["onnxruntime"] is None:
            raise DictationFailure(2, "Движок onnxruntime недоступен в выбранном Python.")
        if wav is not None or args.toggle:
            request = model_request(args)
            facts.update(variant=request["variant"], threads=request["threads"])
            supervisor.send(request, timeout=10)
            _, loaded = wait("model.loaded", 12)
            facts["engine_version"] = loaded["engine_version"]
            steps.append("Модель загружена.")
        started = time.monotonic()
        if args.toggle:
            fsm.press(started)
            fsm.release(started + PTT_THRESHOLD_S / 2)
            if fsm.state != HotkeyState.RECORDING:
                raise DictationFailure(1, "Короткий тап оборвал запись в режиме toggle.")
        else:
            supervisor.send({"type": "record.start", "utterance_id": "d1", "device": device})
        ready_at, _ = wait("audio.ready", 10, 1)
        facts["audio_ready_ms"] = (ready_at - started) * 1000
        steps.append(f"Источник {device} готов к записи.")
        if wav is None:
            facts["silence_seconds"] = args.silence
            record_for(max(0, ready_at + args.silence - time.monotonic()))
            # Длительность задаёт окно наблюдения; поздний silent не даёт PASS.
            if args.limit:
                wait("record.limit", 0, 1)
            elapsed = facts["silent_ms"]
            if args.toggle:
                second_tap()
                wait("result", 120, 1)
                fsm.done(time.monotonic())
            else:
                supervisor.send({"type": "record.cancel", "utterance_id": "d1"})
                wait("cancelled", 3, 1)
            if elapsed is None:
                return 1, "За время записи событие silent не получено."
            if elapsed > SILENT_LIMIT_MS:
                return 1, "Событие silent пришло позже порога."
            if args.expect is not None:
                return 1, "В режиме тишины нет распознанного текста для --expect."
            return 0, "Измерено время от callback(audio.ready) до callback(silent)."
        steps.append(f"Воспроизведение {wav} в av_test.")
        player = subprocess.Popen(
            ["paplay", "--device=av_test", str(wav)], stdout=subprocess.DEVNULL
        )
        deadline = time.monotonic() + duration + 30
        while player.poll() is None:
            if time.monotonic() >= deadline:
                raise DictationFailure(2, "paplay не завершился за длительность WAV плюс 30 с.")
            pump(deadline - time.monotonic())
        facts["paplay_returncode"] = player.returncode
        if player.returncode:
            raise DictationFailure(2, f"paplay завершился с кодом {player.returncode}.")
        record_for(0.2)
        if args.limit:
            wait("record.limit", 2, 1)
        # Лимит уже остановил запись в WorkerState: повторный stop даёт bad-state.
        if args.toggle:
            second_tap()
        else:
            if not facts["record_limit"]:
                supervisor.send({"type": "record.stop", "utterance_id": "d1"})
            supervisor.send({"type": "recognize", "utterance_id": "d1"}, timeout=120)
        _, result = wait("result", 120, 1)
        if args.toggle:
            fsm.done(time.monotonic())
        facts.update(text=result["text"], t_ms=result["t_ms"])
        if args.expect is not None:
            matched = args.expect.casefold() in result["text"].casefold()
            facts["expect_matched"] = matched
            if not matched:
                return 1, "Распознанный текст не содержит подстроку из --expect."
        return 0, "Получен result для диктовки d1."

    code, explanation = 2, "Прогон не завершён."
    try:
        code, explanation = run()
    except DictationFailure as exc:
        code, explanation = exc.code, str(exc)
    except KeyboardInterrupt:
        explanation = "Проверка прервана пользователем (Ctrl+C)."
    except (
        OSError,
        TypeError,
        ValueError,
        RuntimeError,
        ipc.FrameError,
        wave.Error,
        EOFError,
        subprocess.SubprocessError,
    ) as exc:
        explanation = f"Не удалось выполнить проверку: {exc}"
    finally:
        # Повторный Ctrl+C не должен прерывать освобождение звуковых ресурсов.
        previous_sigint = signal.signal(signal.SIGINT, signal.SIG_IGN)
        cleanup_errors: list[str] = []
        try:
            try:
                if player is not None and player.poll() is None:
                    player.terminate()
                    try:
                        player.wait(timeout=2)
                    except subprocess.TimeoutExpired:
                        player.kill()
                        player.wait(timeout=2)
            except (OSError, subprocess.SubprocessError) as exc:
                cleanup_errors.append(f"Не удалось остановить paplay: {exc}")
            finally:
                try:
                    supervisor.stop()
                except (OSError, RuntimeError, subprocess.SubprocessError) as exc:
                    cleanup_errors.append(f"Не удалось остановить воркер: {exc}")
                finally:
                    if virtual_started:
                        try:
                            virtual_mic("down")
                            steps.append("Виртуальный микрофон выгружен.")
                        except (DictationFailure, OSError, subprocess.SubprocessError) as exc:
                            cleanup_errors.append(
                                f"Не удалось выгрузить виртуальный микрофон: {exc}"
                            )
        finally:
            signal.signal(signal.SIGINT, previous_sigint)
        if cleanup_errors:
            facts["cleanup_errors"] = cleanup_errors
            code = 2
            explanation += " " + " ".join(cleanup_errors)

    verdict = {0: "уложились", 1: "не уложились", 2: "прогнать не удалось"}[code]
    facts.update(exit_code=code, verdict=verdict, explanation=explanation)
    if args.json:
        print(json.dumps(facts, ensure_ascii=False), flush=True)
    else:
        print("Способ: dictation (запись через воркер, без хоткея и GUI).")
        for step in steps:
            print(step)
        if "text" in facts:
            print(f"Распознанный текст: {facts['text']}")
            print(f"t_ms: {facts['t_ms']} мс.")
        elapsed = facts["silent_ms"]
        measured = "не измерено" if elapsed is None else f"{elapsed:.3f} мс"
        print(f"До silent: {measured}; порог ≤ {SILENT_LIMIT_MS:g} мс.")
        print(f"record.limit: {'получен' if facts['record_limit'] else 'не получен'}.")
        print(
            f"Событий level: {facts['level_count']}; максимум peak_dbfs: {facts['max_peak_dbfs']}."
        )
        print(f"Вердикт: {verdict}. {explanation}")
    return code


@contextmanager
def isolated_network_environment() -> Iterator[None]:
    """На время прогона убирает прокси и внешний offline, затем возвращает их."""
    saved = {
        name: value
        for name, value in os.environ.items()
        if name.lower().endswith("_proxy") or name == "HF_HUB_OFFLINE"
    }
    try:
        for name in saved:
            del os.environ[name]
        yield
    finally:
        os.environ.update(saved)


def network_report(
    args: argparse.Namespace, checks: list[Message], notes: list[str], error: str = ""
) -> int:
    """Печатает ожидания, факты и общий вердикт одним текстом либо JSON-объектом."""
    passed = sum(bool(check["passed"]) for check in checks)
    code = 2 if error else int(passed != len(checks))
    verdict = {0: "ожидания совпали", 1: "есть несовпадения", 2: "прогон невозможен"}[code]
    if args.json:
        print(
            json.dumps(
                {
                    "command": args.command,
                    "checks": checks,
                    "notes": notes,
                    "passed": passed,
                    "total": len(checks),
                    "verdict": verdict,
                    "explanation": error,
                    "exit_code": code,
                },
                ensure_ascii=False,
            ),
            flush=True,
        )
    else:
        for note in notes:
            print(note)
        for check in checks:
            result = "совпало" if check["passed"] else "НЕ СОВПАЛО"
            print(
                f"{check['name']}: ожидание — {check['expected']}; "
                f"факт — {check['actual']}; вердикт — {result}."
            )
        print(f"Итог: {passed}/{len(checks)}; {verdict}; код {code}.")
        if error:
            print(error)
    return code


def downloads(args: argparse.Namespace) -> int:
    """Проверяет настоящий Downloader на локальном сервере с повреждёнными ответами."""
    checks: list[Message] = []
    notes = [
        "Способ: настоящий Downloader и TCP-сервер на 127.0.0.1, случайный порт.",
        "Байты считаются на выходе настоящего StreamResponse.iter_chunks; "
        "внешний транспорт перехватывается до DNS и соединения.",
    ]
    try:
        import requests

        from astra_voice.models.catalog import CatalogEntry, FileSpec
        from astra_voice.models.downloader import Downloader, DownloadError
        from astra_voice.models.store import ModelStore
        from astra_voice.net import http
        from astra_voice.net.gate import NetworkGate, NetworkKind
        from astra_voice.net.http import HttpClient, NetworkError, StreamResponse
    except ImportError as exc:
        return network_report(args, checks, notes, f"Не удалось загрузить зависимости: {exc}")

    # Половина кратна блоку Downloader: обрыв оставляет уже прочитанные данные на диске.
    body = bytes(range(256)) * 512
    size, half = len(body), len(body) // 2
    digest = hashlib.sha256(body).hexdigest()
    seen: list[tuple[str, str | None, int]] = []
    bytes_read = 0
    foreign_attempts = 0

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self) -> None:
            mode = self.path.removeprefix("/")
            range_header = self.headers.get("Range")
            first = not any(path == self.path for path, _, _ in seen)
            interrupted = mode == "truncated" or (mode in {"resume-206", "no-range-200"} and first)
            payload, status = body, 200
            headers: dict[str, str] = {}
            if mode == "redirect-evil":
                payload, status = b"", 302
                headers["Location"] = "https://evil.example/model.bin"
            elif mode == "tampered":
                payload = bytes(byte ^ 255 for byte in body)
            elif mode == "oversize":
                payload = body + b"!"
            elif mode == "resume-206" and range_header is not None:
                offset = int(range_header.removeprefix("bytes=").removesuffix("-"))
                payload, status = body[offset:], 206
                headers["Content-Range"] = f"bytes {offset}-{size - 1}/{size}"
            seen.append((self.path, range_header, status))
            try:
                self.send_response(status)
                self.send_header(
                    "Content-Length", str(size if mode == "oversize" else len(payload))
                )
                if interrupted or mode == "oversize":
                    self.send_header("Transfer-Encoding", "chunked")
                for name, value in headers.items():
                    self.send_header(name, value)
                self.end_headers()
                if interrupted:
                    prefix = payload[:half]
                    self.wfile.write(f"{len(prefix):x}\r\n".encode() + prefix + b"\r\n")
                    self.wfile.flush()
                    # Нет завершающего chunk: urllib3 1.26 тоже видит обрыв.
                    self.close_connection = True
                elif mode == "oversize":
                    self.wfile.write(f"{len(payload):x}\r\n".encode() + payload + b"\r\n0\r\n\r\n")
                else:
                    self.wfile.write(payload)
            except (BrokenPipeError, ConnectionResetError):
                pass

        def log_message(self, format: str, *args: object) -> None:
            """Служебный журнал сервера не попадает в отчёт."""

    original_send = requests.adapters.HTTPAdapter.send
    original_chunks = StreamResponse.iter_chunks

    def local_send(
        self: requests.adapters.HTTPAdapter, request: requests.PreparedRequest, **kwargs: Any
    ) -> requests.Response:
        nonlocal foreign_attempts
        if urlsplit(request.url).netloc != local_host:
            foreign_attempts += 1
            raise NetworkError("transport-intercepted", "Перехвачена попытка выхода наружу.")
        return original_send(self, request, **kwargs)

    def counted_chunks(self: StreamResponse, chunk_size: int = 65536) -> Iterator[bytes]:
        nonlocal bytes_read
        for block in original_chunks(self, chunk_size):
            bytes_read += len(block)
            yield block

    class LocalHttpClient(HttpClient):
        def get_stream(
            self,
            url: str,
            *,
            range_from: int | None = None,
            deadline_s: float,
            cancel: threading.Event,
            kind: NetworkKind = "download",
        ) -> StreamResponse:
            # Downloader собирает HTTPS; только адрес этого сервера переводим в HTTP.
            prefix = f"https://{local_host}/"
            if url.startswith(prefix):
                url = "http://" + url.removeprefix("https://")
            return super().get_stream(
                url,
                range_from=range_from,
                deadline_s=min(deadline_s, 5),
                cancel=cancel,
                kind=kind,
            )

    server: ThreadingHTTPServer | None = None
    thread: threading.Thread | None = None
    local_policy = None
    original_policy = http.ALLOWED_HOSTS, http.ALLOWED_SCHEMES, http.ALLOWED_PORTS
    error = ""
    try:
        server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        local_host = f"127.0.0.1:{server.server_port}"
        notes.append(f"Адрес сервера: http://{local_host}.")
        # HTTPS и 443 оставляем, чтобы redirect-evil проверял именно запрет чужого хоста.
        local_policy = patch.multiple(
            http,
            ALLOWED_HOSTS=("127.0.0.1",),
            ALLOWED_SCHEMES=(*original_policy[1], "http"),
            ALLOWED_PORTS=(*original_policy[2], server.server_port),
        )
        local_policy.start()
        thread = threading.Thread(target=server.serve_forever, kwargs={"poll_interval": 0.01})
        thread.start()
        with (
            isolated_network_environment(),
            tempfile.TemporaryDirectory(prefix="astra-downloads-") as directory,
            patch.object(requests.adapters.HTTPAdapter, "send", local_send),
            patch.object(StreamResponse, "iter_chunks", counted_chunks),
        ):
            store = ModelStore(Path(directory) / "models")
            if not store.disk_ok(size):
                raise RuntimeError("Недостаточно свободного места для прогона.")
            client = LocalHttpClient(
                NetworkGate(settings.Settings(), policy.Policy()), user_agent="Astra-Voice/validate"
            )
            loader = Downloader(client, store)

            def attempt(entry: CatalogEntry) -> str:
                try:
                    loader.download(entry, progress=lambda state: None, cancel=threading.Event())
                except DownloadError as exc:
                    return exc.code
                return "ok"

            for mode in (
                "ok",
                "resume-206",
                "no-range-200",
                "truncated",
                "tampered",
                "oversize",
                "redirect-evil",
            ):
                entry = CatalogEntry(
                    id=mode,
                    revision="rev-1",
                    name="Проверка загрузки",
                    description="Синтетический файл локального прогона",
                    size_bytes=size,
                    min_ram_mb=1,
                    layout="gigaam-rnnt",
                    variant="int8",
                    recommended=False,
                    host=local_host,
                    files=(FileSpec("model.bin", digest, size, f"/{mode}"),),
                )
                staging = store.staging_dir(entry.id, entry.revision)
                target, part = staging / "model.bin", staging / "model.bin.part"
                bytes_read, foreign_attempts = 0, 0

                first_code = attempt(entry)
                prefix_ok = part.is_file() and part.read_bytes() == body[:half]
                code = first_code
                resumed = mode in {"resume-206", "no-range-200"}
                if resumed:
                    code = attempt(entry)
                requests_seen = [
                    (header, status) for path, header, status in seen if path == f"/{mode}"
                ]
                file_ok = (
                    target.is_file() and hashlib.sha256(target.read_bytes()).hexdigest() == digest
                )
                expected_code = {
                    "truncated": "host-unreachable",
                    "tampered": "bad-checksum",
                    "oversize": "too-large",
                    "redirect-evil": "not-allowed",
                }.get(mode, "ok")
                expected = expected_code
                actual = f"код {code}"
                matched = code == expected_code and foreign_attempts == 0
                if expected_code == "ok":
                    expected += ", верный файл и SHA-256, без .part"
                    actual += (
                        f", файл и SHA-256 {'верны' if file_ok else 'неверны'}, "
                        f".part={part.exists()}"
                    )
                    matched &= file_ok and not part.exists()
                if resumed:
                    status = 206 if mode == "resume-206" else 200
                    expected += f", сначала обрыв с половиной в .part, затем Range и {status}"
                    actual += f", первый код {first_code}, половина сохранена={prefix_ok}"
                    matched &= first_code == "host-unreachable" and prefix_ok
                    matched &= requests_seen == [(None, 200), (f"bytes={half}-", status)]
                else:
                    matched &= requests_seen == [(None, 302 if mode == "redirect-evil" else 200)]
                if mode == "truncated":
                    expected += ", половина файла сохранена в .part"
                    actual += f", половина сохранена={prefix_ok}"
                    matched &= prefix_ok and not target.exists()
                if mode == "oversize":
                    expected += f", прочитано не больше {size + 1} байт"
                    actual += f", прочитано {bytes_read} байт"
                    matched &= 0 < bytes_read <= size + 1
                if mode == "redirect-evil":
                    expected += ", попыток к чужому хосту 0"
                    actual += f", попыток к чужому хосту {foreign_attempts}"
                actual += f", запросы (Range, статус): {requests_seen}"
                checks.append(
                    {"name": mode, "expected": expected, "actual": actual, "passed": matched}
                )
    except (OSError, RuntimeError, ValueError) as exc:
        error = f"Не удалось выполнить прогон: {exc}"
    finally:
        if local_policy is not None:
            local_policy.stop()
        if server is not None:
            try:
                if thread is not None and thread.is_alive():
                    server.shutdown()
            finally:
                server.server_close()
                if thread is not None and thread.ident is not None:
                    thread.join(timeout=3)
                    if thread.is_alive():
                        error = "Не удалось остановить локальный сервер."
    return network_report(args, checks, notes, error)


def privacy(args: argparse.Namespace) -> int:
    """Проверяет запреты сети до первой попытки обращения к транспорту requests."""
    checks: list[Message] = []
    notes = [
        "Способ: счётчик requests.adapters.HTTPAdapter.send — вход в транспорт "
        "перехвачен раньше DNS и socket.connect; каждый вызов останавливается до сети.",
        "Это проверка счётчиком попыток; полную проверку tcpdump выполняет человек "
        "по docs/plans.md, раздел M5.",
    ]
    try:
        import requests

        from astra_voice.net.gate import NetworkGate, NetworkKind
        from astra_voice.net.http import HttpClient, NetworkError
    except ImportError as exc:
        return network_report(args, checks, notes, f"Не удалось загрузить зависимости: {exc}")

    attempts = 0

    class TransportIntercepted(Exception):
        """Отличает перехват транспорта от отказа настоящего HttpClient."""

    def denied_send(
        self: requests.adapters.HTTPAdapter, request: requests.PreparedRequest, **kwargs: object
    ) -> requests.Response:
        nonlocal attempts
        attempts += 1
        raise TransportIntercepted

    offline = policy.Policy(values={"offline": True}, status=policy.PolicyStatus.OK)
    online = policy.Policy(values={"offline": False}, status=policy.PolicyStatus.OK)
    scenarios = (
        ("по умолчанию, политика offline", settings.Settings(), offline, False),
        (
            "тумблеры включены, политика offline",
            settings.Settings(check_app_updates=True, check_model_updates=True),
            offline,
            False,
        ),
        ("тумблеры выключены, политика разрешает", settings.Settings(), online, True),
    )
    kinds: tuple[NetworkKind, ...] = ("download", "check_app", "check_models")
    error = ""
    try:
        with (
            isolated_network_environment(),
            patch.object(requests.adapters.HTTPAdapter, "send", denied_send),
        ):
            for name, config, rules, explicit_download in scenarios:
                gate = NetworkGate(config, rules)
                client = HttpClient(gate, user_agent="Astra-Voice/validate")
                for kind in kinds:
                    attempts = 0
                    allowed, reason = gate.allowed(kind)
                    expected_allowed = explicit_download and kind == "download"
                    result = "ответ без ошибки"
                    try:
                        with client.get_stream(
                            "https://huggingface.co/validate",
                            deadline_s=1,
                            cancel=threading.Event(),
                            kind=kind,
                        ):
                            pass
                    except NetworkError as exc:
                        result = exc.code
                    except TransportIntercepted:
                        result = "перехват транспорта"
                    expected_result = "перехват транспорта" if expected_allowed else "no-network"
                    expected_attempts = int(expected_allowed)
                    expected = (
                        f"гейт {'открыт' if expected_allowed else 'закрыт'}, "
                        f"{expected_result}, попыток {expected_attempts}"
                    )
                    actual = (
                        f"гейт {'открыт' if allowed else 'закрыт'}, {result}, попыток {attempts}"
                    )
                    if reason:
                        actual += f" ({reason})"
                    checks.append(
                        {
                            "name": f"{name} / {kind}",
                            "expected": expected,
                            "actual": actual,
                            "passed": allowed == expected_allowed
                            and result == expected_result
                            and attempts == expected_attempts,
                        }
                    )
        notes.append(
            "Разрешённый download — явное действие пользователя; "
            "его перехват проверяет работу счётчика."
        )
    except (OSError, RuntimeError, ValueError) as exc:
        error = f"Не удалось выполнить прогон: {exc}"
    return network_report(args, checks, notes, error)


def main(argv: list[str] | None = None) -> int:
    """Разбирает подкоманды; новые проверки добавляются отдельными обработчиками."""
    parser = argparse.ArgumentParser(description="Проверки Astra Voice без GUI")
    commands = parser.add_subparsers(dest="command", required=True)
    summary = commands.add_parser("stats", help="проверить p95 локальной статистики")
    summary.add_argument("--json", action="store_true", help="один JSON-объект в stdout")
    summary.add_argument("--target-ms", type=delay_ms, default=500.0, help="цель p95 в мс")
    summary.add_argument(
        "--since", type=delay_ms, help="учитывать события после Unix-времени начала прогона"
    )
    cancel = commands.add_parser("worker-cancel", help="измерить отмену через IPC")
    cancel.add_argument("--model-dir", type=Path, help="каталог модели, если она не настроена")
    cancel.add_argument("--variant", help="вариант модели вместо настройки")
    cancel.add_argument("--threads", type=positive_int, help="потоки вместо настройки (обычно 2)")
    cancel.add_argument("--wav", type=Path, default=ROOT / "data/test/test-ru-20s.wav")
    cancel.add_argument("--cancel-after-ms", type=delay_ms, default=300.0)
    cancel.add_argument("--json", action="store_true", help="один JSON-объект в stdout")
    dictate = commands.add_parser("dictation", help="проверить диктовку без хоткея и GUI")
    dictate.add_argument(
        "--virtual-mic", action="store_true", help="поднять и выгрузить av_test_src"
    )
    source = dictate.add_mutually_exclusive_group(required=True)
    source.add_argument("--wav", type=Path, help="WAV для paplay --device=av_test")
    source.add_argument("--silence", type=delay_ms, metavar="СЕКУНДЫ", help="длительность тишины")
    dictate.add_argument("--limit", action="store_true", help="потребовать событие record.limit")
    dictate.add_argument(
        "--toggle", action="store_true", help="управлять записью двумя тапами через HotkeyFsm"
    )
    dictate.add_argument("--device", help="источник записи; обязателен без --virtual-mic")
    dictate.add_argument("--expect", help="ожидаемая подстрока текста без учёта регистра")
    dictate.add_argument("--model-dir", type=Path, help="каталог модели, если она не настроена")
    dictate.add_argument("--variant", help="вариант модели вместо настройки")
    dictate.add_argument("--threads", type=positive_int, help="потоки вместо настройки (обычно 2)")
    dictate.add_argument("--json", action="store_true", help="один JSON-объект в stdout")
    download = commands.add_parser("downloads", help="проверить загрузку при сбоях сервера")
    download.add_argument(
        "--faults", action="store_true", required=True, help="локальный сервер-вредитель"
    )
    download.add_argument("--json", action="store_true", help="один JSON-объект в stdout")
    private = commands.add_parser("privacy", help="проверить запрет сетевых соединений")
    private.add_argument(
        "--network-denied",
        action="store_true",
        required=True,
        help="проверить закрытый сетевой гейт",
    )
    private.add_argument("--json", action="store_true", help="один JSON-объект в stdout")
    args = parser.parse_args(argv)
    handlers = {
        "worker-cancel": worker_cancel,
        "dictation": dictation,
        "stats": stats,
        "downloads": downloads,
        "privacy": privacy,
    }
    return handlers[args.command](args)


if __name__ == "__main__":
    raise SystemExit(main())
