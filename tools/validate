def catalog_switch(
    args: argparse.Namespace, entries: tuple[CatalogEntry, ...], store: ModelStore
) -> tuple[int, dict[str, Any]]:
    """Проверяет переключение без GUI и звука.

    Ctrl+C, SIGTERM и SIGHUP дают код 2 с возвратом прежнего выбора модели.
    """
    facts: dict[str, Any] = {
        "command": "catalog",
        "mode": "switch",
        "result": "failed",
        "switch_ms": None,
        "branch": "",
        "old_stopped": False,
        "current_is_b": False,
        "loaded_is_b": False,
        "new_pid": None,
        "new_process": False,
        "workers_stopped": False,
        "exit_code": 2,
    }
    current_path = store.root / "current.json"
    original_bytes = current_path.read_bytes() if current_path.exists() else None
    if catalog_runtime_settings().to_dict().get("model_dir"):
        facts["explanation"] = "В настройках задана модель вручную"
        return 2, facts
    records = store.records()
    by_id = {(record.id, record.revision): record for record in records}
    selected_ref = None
    if original_bytes is not None:
        try:
            raw_current = json.loads(original_bytes)
            if isinstance(raw_current, dict):
                candidate = (raw_current.get("id"), raw_current.get("revision"))
                if all(isinstance(part, str) and ID_RE.fullmatch(part) for part in candidate):
                    selected_ref = candidate
        except (ValueError, TypeError):
            pass
    current_record = by_id.get(selected_ref) if selected_ref is not None else None
    current = (
        current_record
        if current_record is not None
        and current_record.state == "ok"
        and current_record.recheck is not True
        and current_record.metadata_ok
        else None
    )
    for ref in (args.from_ref, args.to_ref, selected_ref):
        record = by_id.get(ref) if ref is not None else None
        if record is not None and record.recheck is True:
            facts["explanation"] = f"Модель {record.id}@{record.revision} нужно перепроверить"
            return 2, facts
    pair = choose_catalog_pair(entries, records, current, args.from_ref, args.to_ref)
    if pair is None:
        facts["explanation"] = (
            "Нужно минимум 2 установленные модели"
            if sum(record.state == "ok" and record.recheck is not True for record in records) < 2
            else "Не удалось выбрать две разные модели"
        )
        return 2, facts
    entry_a, _, entry_b, _ = pair
    runtime: Any = None
    old_process: Any = None
    previous_handlers: dict[signal.Signals, Any] = {}
    switch_model_called = False
    interrupted = False

    def interrupt(signum: int, frame: Any) -> None:
        raise KeyboardInterrupt

    def restore_current() -> None:
        if original_bytes is None:
            current_path.unlink(missing_ok=True)
            fsync_store_dir()
            return
        descriptor, temporary = tempfile.mkstemp(prefix=".current.json.restore-", dir=store.root)
        try:
            with os.fdopen(descriptor, "wb") as output:
                output.write(original_bytes)
                output.flush()
                os.fsync(output.fileno())
            os.replace(temporary, current_path)
            fsync_store_dir()
        finally:
            Path(temporary).unlink(missing_ok=True)

    def fsync_store_dir() -> None:
        descriptor = os.open(store.root, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)

    try:
        from PyQt5.QtCore import QCoreApplication, QEventLoop

        app = QCoreApplication.instance() or QCoreApplication([])

        def until(done: Any, timeout: float) -> bool:
            deadline = time.monotonic() + timeout
            while time.monotonic() < deadline:
                app.processEvents(QEventLoop.AllEvents, 50)
                if done():
                    return True
                time.sleep(0.01)
            return False

        prior = f"{selected_ref[0]}@{selected_ref[1]}" if selected_ref else "не выбрана"
        print(f"На время проверки меняю выбранную модель; прежняя — {prior}.", file=sys.stderr)
        for signum in (signal.SIGTERM, signal.SIGHUP):
            previous_handlers[signum] = signal.signal(signum, interrupt)
        store.set_current(entry_a.id, entry_a.revision)
        with (
            patch("astra_voice.runtime.notify", CatalogNotify()),
            patch("astra_voice.runtime.paths.measurements_path", return_value=None),
        ):
            try:
                runtime = make_catalog_runtime(store)
                runtime.start()
                model_a = (entry_a.id, entry_a.revision)

                def loaded_a() -> bool:
                    return (
                        runtime._loaded_model.get("model_id"),
                        runtime._loaded_model.get("revision"),
                    ) == model_a

                def load_a_finished() -> bool:
                    return (
                        loaded_a()
                        or runtime._selfcheck == "failed"
                        or getattr(runtime, "_model_load_failures", 0) > 0
                        or (
                            getattr(runtime, "_model_load_request", None) is not None
                            and not getattr(runtime, "_loading_model", False)
                            and runtime._selfcheck == "idle"
                        )
                    )

                if not until(load_a_finished, CATALOG_LOAD_TIMEOUT_S):
                    raise CatalogSwitchError("Таймаут загрузки модели A")
                if getattr(runtime, "_model_load_failures", 0) > 0 or not loaded_a():
                    raise CatalogSwitchError("Загрузка модели A не удалась")
                if not until(
                    lambda: runtime._selfcheck in ("ok", "failed"), CATALOG_SELFCHECK_TIMEOUT_S
                ):
                    raise CatalogSwitchError("Таймаут самопроверки модели A")
                if runtime._selfcheck != "ok":
                    raise CatalogSwitchError("Самопроверка модели A не прошла")
                old_process = runtime.supervisor.process
                if old_process is None or old_process.poll() is not None:
                    raise CatalogSwitchError("Исходный воркер не работает")
                old_pid = old_process.pid
                pause = not runtime.can_switch_without_pause(entry_b.min_ram_mb)
                facts["branch"] = (
                    "с паузой по свободной памяти (MemAvailable)" if pause else "временный воркер"
                )
                store.set_current(entry_b.id, entry_b.revision)
                results: list[tuple[str, float]] = []

                def on_switch_finished(result: str) -> None:
                    safe_result = result if result in ("ok", "failed") else "failed"
                    results.append((safe_result, time.monotonic()))

                runtime.on_switch_finished = on_switch_finished
                switched = time.monotonic()
                switch_model_called = True
                runtime.switch_model(min_ram_mb=entry_b.min_ram_mb, pause=pause)
                if not until(lambda: bool(results), CATALOG_SWITCH_TIMEOUT_S):
                    raise CatalogSwitchError("Таймаут переключения модели")
                facts["result"] = results[0][0]
                facts["switch_ms"] = round((results[0][1] - switched) * 1000, 1)
                facts["old_stopped"] = old_process.poll() is not None
                loaded = runtime._loaded_model
                facts["loaded_is_b"] = (loaded.get("model_id"), loaded.get("revision")) == (
                    entry_b.id,
                    entry_b.revision,
                )
                selected = store.current()
                facts["current_is_b"] = selected is not None and (
                    selected.id,
                    selected.revision,
                ) == (
                    entry_b.id,
                    entry_b.revision,
                )
                new_process = runtime.supervisor.process
                facts["new_pid"] = new_process.pid if new_process is not None else None
                facts["new_process"] = (
                    new_process is not None
                    and new_process.poll() is None
                    and new_process.pid != old_pid
                )
            finally:
                if runtime is not None:
                    processes = [
                        process
                        for process in (
                            old_process,
                            getattr(runtime.supervisor, "process", None),
                            getattr(getattr(runtime, "_switch_candidate", None), "process", None),
                        )
                        if process is not None
                    ]
                    runtime.shutdown()
                    facts["workers_stopped"] = all(
                        process.poll() is not None for process in processes
                    )
    except (OSError, RuntimeError, ValueError, KeyboardInterrupt) as exc:
        interrupted = isinstance(exc, KeyboardInterrupt)
        facts["result"] = "failed"
        facts["explanation"] = (
            str(exc) if isinstance(exc, CatalogSwitchError) else type(exc).__name__
        )
    finally:
        try:
            if previous_handlers:
                previous_mask = signal.pthread_sigmask(
                    signal.SIG_BLOCK, {signal.SIGINT, signal.SIGTERM, signal.SIGHUP}
                )
                try:
                    restore_current()
                except KeyboardInterrupt:
                    interrupted = True
                    facts.setdefault("explanation", "KeyboardInterrupt")
                except Exception:
                    prior = f"{selected_ref[0]}@{selected_ref[1]}" if selected_ref else "не выбрана"
                    facts["explanation"] = (
                        f"Не удалось вернуть прежний выбор модели ({prior})"
                        " — выберите её в настройках"
                    )
                    interrupted = True
                finally:
                    try:
                        signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
                    except KeyboardInterrupt:
                        interrupted = True
                        facts.setdefault("explanation", "KeyboardInterrupt")
        finally:
            for signum, handler in previous_handlers.items():
                signal.signal(signum, handler)
    code = catalog_switch_exit_code(facts["result"], facts["old_stopped"], facts["loaded_is_b"])
    if facts.get("explanation") and (not switch_model_called or interrupted):
        code = 2
    if code != 2 and not facts["new_process"]:
        code = 1
    if code != 2 and not facts["workers_stopped"]:
        code = 1
    facts["exit_code"] = code
    return code, facts


def catalog(args: argparse.Namespace) -> int:
    """Общий вход: подписанный каталог и локальное хранилище, без загрузок."""
    lock = None
    locked = False
    try:
        if args.switch and (
            args.store is None or args.store.resolve() == paths.model_store_dir().resolve()
        ):
            from PyQt5.QtCore import QLockFile

            lock = QLockFile(str(paths.lock_path()))
            if not lock.tryLock(paths.LOCK_TIMEOUT_MS):
                facts = {
                    "command": "catalog",
                    "mode": "switch",
                    "result": "failed",
                    "loaded_is_b": False,
                    "current_is_b": False,
                    "explanation": "Закройте Astra Voice и повторите проверку",
                    "exit_code": 2,
                }
                return catalog_report(args, 2, facts)
            locked = True
        entries = load_catalog().entries
        store = ModelStore(args.store if args.store is not None else paths.model_store_dir())
        code, facts = (
            catalog_all(args, entries, store) if args.all else catalog_switch(args, entries, store)
        )
    except Exception as exc:
        code = 2
        facts = {
            "command": "catalog",
            "mode": "all" if args.all else "switch",
            "rows": [],
            "verdict": "прогон невозможен",
            "explanation": type(exc).__name__,
            "exit_code": 2,
        }
    finally:
        if locked and lock is not None:
            lock.unlock()
    return catalog_report(args, code, facts)


def catalog_report(args: argparse.Namespace, code: int, facts: dict[str, Any]) -> int:
    """Выводит только проверенные факты каталога."""
    if args.json:
        print(json.dumps(facts, ensure_ascii=False), flush=True)
    elif args.all:
        print(format_catalog_table(facts["rows"]))
        print(f"Итог: {facts['verdict']}; код {code}.")
        if facts.get("explanation"):
            print(facts["explanation"])
    else:
        print(
            f"Итог: {facts.get('result', 'failed')}; "
            f"переключение: {facts.get('switch_ms')} мс; ветка: {facts.get('branch', '')}."
        )
        print(
            f"Старый воркер остановлен: {'да' if facts.get('old_stopped') else 'нет'}; "
            f"загружена модель B: {'да' if facts.get('loaded_is_b') else 'нет'}; "
            f"выбор в хранилище B: {'да' if facts.get('current_is_b') else 'нет'}; "
            f"новый процесс (pid {facts.get('new_pid')}): "
            f"{'да' if facts.get('new_process') else 'нет'}."
        )
        if facts.get("explanation"):
            print(facts["explanation"])
    return code


def main(argv: list[str] | None = None) -> int:
    """Разбирает подкоманды; новые проверки добавляются отдельными обработчиками."""
    parser = argparse.ArgumentParser(description="Проверки Astra Voice без GUI")
    commands = parser.add_subparsers(dest="command", required=True)
    summary = commands.add_parser("stats", help="проверить p95 локальной статистики")
    summary.add_argument("--json", action="store_true", help="один JSON-объект в stdout")
    summary.add_argument("--target-ms", type=delay_ms, default=500.0, help="цель p95 в мс")
    summary.add_argument(
        "--since", type=delay_ms, help="учитывать события после Unix-времени начала прогона"
    )
    cancel = commands.add_parser("worker-cancel", help="измерить отмену через IPC")
    cancel.add_argument("--model-dir", type=Path, help="каталог модели, если она не настроена")
    cancel.add_argument("--variant", help="вариант модели вместо настройки")
    cancel.add_argument("--threads", type=positive_int, help="потоки вместо настройки (обычно 2)")
    cancel.add_argument("--wav", type=Path, default=ROOT / "data/test/test-ru-20s.wav")
    cancel.add_argument("--cancel-after-ms", type=delay_ms, default=300.0)
    cancel.add_argument("--json", action="store_true", help="один JSON-объект в stdout")
    dictate = commands.add_parser("dictation", help="проверить диктовку без хоткея и GUI")
    dictate.add_argument(
        "--virtual-mic", action="store_true", help="поднять и выгрузить av_test_src"
    )
    source = dictate.add_mutually_exclusive_group(required=True)
    source.add_argument("--wav", type=Path, help="WAV для paplay --device=av_test")
    source.add_argument("--silence", type=delay_ms, metavar="СЕКУНДЫ", help="длительность тишины")
    dictate.add_argument("--limit", action="store_true", help="потребовать событие record.limit")
    dictate.add_argument(
        "--toggle", action="store_true", help="управлять записью двумя тапами через HotkeyFsm"
    )
    dictate.add_argument("--device", help="источник записи; обязателен без --virtual-mic")
    dictate.add_argument("--expect", help="ожидаемая подстрока текста без учёта регистра")
    dictate.add_argument("--model-dir", type=Path, help="каталог модели, если она не настроена")
    dictate.add_argument("--variant", help="вариант модели вместо настройки")
    dictate.add_argument("--threads", type=positive_int, help="потоки вместо настройки (обычно 2)")
    dictate.add_argument("--json", action="store_true", help="один JSON-объект в stdout")
    download = commands.add_parser("downloads", help="проверить загрузку при сбоях сервера")
    download.add_argument(
        "--faults", action="store_true", required=True, help="локальный сервер-вредитель"
    )
    download.add_argument("--json", action="store_true", help="один JSON-объект в stdout")
    private = commands.add_parser("privacy", help="проверить запрет сетевых соединений")
    private.add_argument(
        "--network-denied",
        action="store_true",
        required=True,
        help="проверить закрытый сетевой гейт",
    )
    private.add_argument("--json", action="store_true", help="один JSON-объект в stdout")
    models = commands.add_parser("catalog", help="проверить установленные модели и переключение")
    mode = models.add_mutually_exclusive_group(required=True)
    mode.add_argument("--all", action="store_true", help="смоук каждой установленной модели")
    mode.add_argument("--switch", action="store_true", help="проверить смену двух моделей")
    models.add_argument("--store", type=Path, metavar="DIR", help="локальное хранилище моделей")
    models.add_argument(
        "--timeout",
        type=positive_finite,
        default=CATALOG_MODEL_TIMEOUT_S,
        help="таймаут одной модели, с; для --switch игнорируется",
    )
    models.add_argument("--from", dest="from_ref", type=parse_model_ref, metavar="ID@REV")
    models.add_argument("--to", dest="to_ref", type=parse_model_ref, metavar="ID@REV")
    models.add_argument("--json", action="store_true", help="один JSON-объект в stdout")
    release_check = commands.add_parser("release", help="проверить ассеты релиза без сети")
    release_check.add_argument("--version", required=True, help="версия X.Y.Z или vX.Y.Z")
    release_check.add_argument("--dir", type=Path, default=ROOT / "dist")
    release_check.add_argument("--keyring", type=Path, default=ROOT / "data/keys/release.gpg")
    release_check.add_argument("--json", action="store_true", help="один JSON-объект в stdout")
    probe = commands.add_parser("_catalog-probe", help=argparse.SUPPRESS)
    probe.add_argument("--model-dir", type=Path, required=True)
    probe.add_argument("--layout", required=True)
    probe.add_argument("--variant", required=True)
    probe.add_argument("--wav", type=Path, required=True)
    args = parser.parse_args(argv)
    if args.command == "catalog" and args.all and (args.from_ref or args.to_ref):
        parser.error("--from/--to применимы только с --switch")
    handlers = {
        "worker-cancel": worker_cancel,
        "dictation": dictation,
        "stats": stats,
        "downloads": downloads,
        "privacy": privacy,
        "catalog": catalog,
        "release": release,
        "_catalog-probe": catalog_probe,
    }
    return handlers[args.command](args)


if __name__ == "__main__":
    raise SystemExit(main())
