def catalog_probe(args: argparse.Namespace) -> int:
    """Дочерний процесс: 2 потока; раскладка и вариант из каталога; PCM как у воркера."""
    from astra_voice.worker.engine import CancelToken, make_engine
    from astra_voice.worker.state import WorkerState

    result: dict[str, Any] = {
        "load_ms": None,
        "infer_ms": None,
        "audio_s": None,
        "text_len": 0,
        "match": False,
        "ok": False,
        "error": "",
    }
    engine = None
    try:
        import numpy as np

        engine = make_engine(args.layout)
        started = time.perf_counter()
        engine.load(args.model_dir, args.layout, args.variant, 2)
        result["load_ms"] = round((time.perf_counter() - started) * 1000, 1)
        samples = WorkerState._read_wav(args.wav)
        audio = np.frombuffer(samples, dtype=np.float32)
        result["audio_s"] = round(len(samples) / 16000, 3)
        started = time.perf_counter()
        recognized = engine.transcribe(audio, CancelToken())
        result["infer_ms"] = round((time.perf_counter() - started) * 1000, 1)
        result["text_len"] = len(recognized.text.strip())
        result["match"] = smoke_matches(recognized.text)
        result["ok"] = bool(result["text_len"]) and not recognized.cancelled
        if not result["ok"]:
            result["error"] = "пустой текст"
    except Exception as exc:
        # Исключения движка могут содержать путь и фрагмент входа; наружу идёт только тип.
        result["error"] = type(exc).__name__
    finally:
        if engine is not None:
            try:
                engine.unload()
            except Exception:
                pass
    print(json.dumps(result, ensure_ascii=False), flush=True)
    return 0


def run_catalog_probe(
    model_dir: Path, layout: str, variant: str, wav: Path, timeout: float
) -> dict[str, Any]:
    """Ограничивает весь жизненный цикл движка отдельным убиваемым процессом."""
    command = [
        sys.executable,
        str(ROOT / "tools/validate"),
        "_catalog-probe",
        "--model-dir",
        str(model_dir),
        "--layout",
        layout,
        "--variant",
        variant,
        "--wav",
        str(wav),
    ]
    try:
        completed = subprocess.run(
            command, capture_output=True, text=True, timeout=timeout, check=False
        )
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": "таймаут"}
    except (OSError, subprocess.SubprocessError):
        return {"ok": False, "error": "не удалось запустить процесс"}
    if completed.returncode:
        return {"ok": False, "error": f"код процесса {completed.returncode}"}
    try:
        lines = completed.stdout.splitlines()
        if len(lines) != 1:
            raise ValueError
        value = json.loads(lines[0])
        if not isinstance(value, dict) or type(value.get("ok")) is not bool:
            raise ValueError
        return value
    except (ValueError, TypeError):
        return {"ok": False, "error": "неверный ответ процесса"}


def catalog_exit_code(rows: list[dict[str, Any]]) -> int:
    """Код 2 означает отсутствие установленной модели, 1 — её неуспешный смоук."""
    installed = [row for row in rows if row["installed"]]
    if not installed:
        return 2
    return int(any(row["status"] != "ок" for row in installed))


def format_catalog_table(rows: list[dict[str, Any]]) -> str:
    """Форматирует фиксированные колонки без вывода распознанной речи."""
    headers = (
        "модель",
        "раскладка",
        "загрузка, мс",
        "распознавание, мс",
        "RTFx",
        "текст",
        "эталон",
        "итог",
    )

    def value(row: dict[str, Any], field: str) -> str:
        item = row.get(field)
        return "—" if item is None else str(item)

    lines = [headers]
    for row in rows:
        lines.append(
            (
                value(row, "model"),
                value(row, "layout"),
                value(row, "load_ms"),
                value(row, "infer_ms"),
                "—" if row.get("rtfx") is None else f"{row['rtfx']:.1f}",
                "да" if row.get("text") else "нет",
                "—" if row.get("match") is None else "да" if row["match"] else "нет",
                value(row, "status"),
            )
        )
    widths = [max(len(line[index]) for line in lines) for index in range(len(headers))]
    return "\n".join(
        "  ".join(cell.ljust(widths[index]) for index, cell in enumerate(line)).rstrip()
        for line in lines
    )


def catalog_all(
    args: argparse.Namespace, entries: tuple[CatalogEntry, ...], store: ModelStore
) -> tuple[int, dict[str, Any]]:
    """Проверяет только исправные установленные ревизии каталога."""
    records = {(record.id, record.revision): record for record in store.records()}
    wav = smoke_wav_path()
    rows: list[dict[str, Any]] = []
    for entry in entries:
        record = records.get((entry.id, entry.revision))
        installed = record is not None and record.state == "ok"
        row: dict[str, Any] = {
            "model": f"{entry.id}@{entry.revision}",
            "layout": entry.layout,
            "load_ms": None,
            "infer_ms": None,
            "rtfx": None,
            "text": False,
            "match": None,
            "status": "повреждена"
            if record is not None and record.state == "broken"
            else "пропущена"
            if installed and not wav.is_file()
            else "не установлена",
            "installed": installed,
        }
        if installed and wav.is_file():
            assert record is not None
            try:
                result = run_catalog_probe(
                    record.dir, entry.layout, entry.variant, wav, args.timeout
                )
            except (TimeoutError, subprocess.TimeoutExpired):
                result = {"ok": False, "error": "таймаут"}
            except Exception:
                result = {"ok": False, "error": "сбой движка"}
            for field in ("load_ms", "infer_ms"):
                number = result.get(field)
                if type(number) in (int, float) and math.isfinite(number) and number >= 0:
                    row[field] = round(number, 1)
            row["text"] = type(result.get("text_len")) is int and result["text_len"] > 0
            row["match"] = result.get("match") if type(result.get("match")) is bool else None
            audio_s, infer_ms = result.get("audio_s"), row["infer_ms"]
            if (
                type(audio_s) in (int, float)
                and math.isfinite(audio_s)
                and infer_ms
                and infer_ms > 0
            ):
                row["rtfx"] = round(audio_s / (infer_ms / 1000), 1)
            if result.get("error") == "таймаут":
                row["status"] = "таймаут"
            elif result.get("ok") is True and row["text"]:
                row["status"] = "ок"
            elif not row["text"] and result.get("ok") is True:
                row["status"] = "ошибка: пустой текст"
            else:
                # Ответ процесса недоверенный: не включаем произвольный текст и пути.
                reason = str(result.get("error", "сбой"))
                allowed = {
                    "таймаут",
                    "пустой текст",
                    "не удалось запустить процесс",
                    "неверный ответ процесса",
                    "сбой движка",
                }
                process_code = reason.removeprefix("код процесса ")
                if reason not in allowed and not (
                    reason.startswith("код процесса ") and process_code.lstrip("-").isdigit()
                ):
                    reason = "сбой движка"
                row["status"] = f"ошибка: {reason}"
        rows.append(row)
    code = 2 if not wav.is_file() else catalog_exit_code(rows)
    return code, {
        "command": "catalog",
        "mode": "all",
        "rows": rows,
        "verdict": {0: "ок", 1: "failed", 2: "прогон невозможен"}[code],
        "exit_code": code,
        "explanation": "Эталонный WAV не найден." if not wav.is_file() else "",
    }


def parse_model_ref(raw: str) -> tuple[str, str]:
    """Разбирает полный идентификатор одной ревизии."""
    from astra_voice.models.catalog import ID_RE

    parts = raw.split("@")
    if len(parts) != 2 or any(ID_RE.fullmatch(part) is None for part in parts):
        raise argparse.ArgumentTypeError("Нужен идентификатор ID@REV.")
    return parts[0], parts[1]


def choose_catalog_pair(
    entries: tuple[CatalogEntry, ...],
    records: tuple[ModelRecord, ...],
    current: ModelRecord | None,
    from_ref: tuple[str, str] | None,
    to_ref: tuple[str, str] | None,
) -> tuple[CatalogEntry, ModelRecord, CatalogEntry, ModelRecord] | None:
    """Выбирает две разные установленные ревизии из проверенного каталога."""
    installed = {
        (record.id, record.revision): record
        for record in records
        if record.state == "ok" and record.recheck is not True
    }
    available = [
        (entry, installed[(entry.id, entry.revision)])
        for entry in entries
        if (entry.id, entry.revision) in installed
    ]
    if len(available) < 2:
        return None
    source = from_ref or ((current.id, current.revision) if current is not None else None)
    if source is None:
        return None
    first = next(
        ((entry, record) for entry, record in available if (entry.id, entry.revision) == source),
        None,
    )
    second = (
        next(
            (
                (entry, record)
                for entry, record in available
                if (entry.id, entry.revision) == to_ref
            ),
            None,
        )
        if to_ref
        else next(
            (
                (entry, record)
                for entry, record in available
                if (entry.id, entry.revision) != source
            ),
            None,
        )
    )
    if first is None or second is None or first[0] == second[0]:
        return None
    return first[0], first[1], second[0], second[1]


