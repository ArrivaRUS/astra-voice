{
  "title": "Тестовые векторы контракта Astra Voice ↔ Astra Cowork (ru.astralinux.Cowork.Command1)",
  "contract": 1,
  "fixed": "2026-09-24",
  "bus_name": "ru.astralinux.Cowork",
  "object_path": "/ru/astralinux/Cowork",
  "interface": "ru.astralinux.Cowork.Command1",
  "spec": "astra-cowork-command1.md",
  "conventions": {
    "typed_value": "объект {\"$dbus\": <сигнатура>, \"value\": …} задаёт тип D-Bus явно (i/u/x/t/d/b/s); обычное число JSON — целое, тип по умолчанию у биндинга (сервер обязан принять i/u/x/t); true/false — тип b; строка — s",
    "text_gen": "{\"repeat\": <строка>, \"count\": N} — строка, повторённая N раз; {\"concat\": [<элементы>]} — конкатенация элементов (строка или repeat); используется для длинных текстов",
    "length": "длина текста — число кодовых точек Unicode (Python len(str)); не байты и не единицы UTF-16",
    "forbidden_chars": "U+0000–U+001F, U+007F–U+009F (включая U+0085), U+2028, U+2029; пустота после strip; длина 1…4000",
    "defaults": "если в векторе нет text — берётся base.text; если нет now_mono_ms — base.now_mono_ms; options_vectors проверяются с валидным текстом, text_vectors — с валидными options; отправитель — тот же UID; сервер готов, сеанс разблокирован, сна не было, окно rate limit закрыто, незавершённых допусков 0",
    "admission_state": "поля state описывают предусловие на стороне сервера (для заглушки исполнителя и тестов C1/S9); значения — по описанию §7 спецификации",
    "nul": "U+0000 в строках D-Bus недопустим — сообщение не уйдёт с клиента (libdbus отвергает); на сервер не попадает, вектора нет; Voice удаляет C0 до отправки"
  },
  "base": {
    "now_mono_ms": 5000000,
