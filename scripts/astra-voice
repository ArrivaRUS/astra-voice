#!/bin/sh
# Лаунчер Astra Voice. Ставится сборкой как /usr/bin/astra-voice
# (packaging/debian/rules, цель override_dh_auto_install).
#
# `-I` (isolated) обязателен: без него PYTHONPATH, user-site и sys.path[0]
# позволяют подсунуть свой модуль вместо нашего (docs/threat-model.md §4.1, У3).
# PYTHONPATH не используется вовсе: vendor подключает bootstrap.py сам (И7).
# Переменные окружения Qt здесь НЕ выставляются: единственный источник правды —
# bootstrap.py, он делает это до импорта Qt (QT_QUICK_CONTROLS_STYLE=Default против
# подмены стиля во Fly `06-fly-misc-env`; QT_QUICK_BACKEND=software +
# QT_XCB_GL_INTEGRATION=none ради RSS, отключается `ASTRA_VOICE_RENDER=gl`).
set -eu
exec /usr/bin/python3 -I /usr/lib/astra-voice/bootstrap.py app "$@"
